       </td>\n        <td>\n            &nbsp;\n        </td>\n        <td>\n            &nbsp;\n        </td>\n    </tr>\n</table>\n\n<br>\n\n<table width=100%>\n    <tr>\n        <td class=\"text-center\">\n            <b>Annexure</b>\n        </td>\n    </tr>\n    <tr>\n        <td class=\"text-center\">\n            <b>PRE-EMPLOYMENT & PERIODIC MEDICAL EXAMINATION</b>\n        </td>\n    </tr>\n</table>\n\n<br>\n\n\n</div>\n",
