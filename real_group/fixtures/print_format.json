  "html": "<table width=100%>\n    <tbody>\n        <tr>\n            <td width=30% style=\"text-align: left; font-size: 20px;\">\n                <br>\n                <br>\n                <b>Pay Slip</b> {{ frappe.utils.formatdate(doc.start_date, 'MMM-yyyy') }}  \n            </td>\n            <td width=70% style=\"text-align: right; font-size: 15px;\">\n                {% if doc.company == \"Real Ispat and Power Ltd\" %}\n                <img src=\"/files/RIPL_FINAL.jpeg\" style=\"width: 40%; height: 50px;\"><br>\n                <b width=50% style=\"text-align: right; font-size: 20px;\">Real Ispat and Power Ltd</b>\n                {% endif %}\n                {% if doc.company == \"API Ispat and Powertech Private Limited\" %}\n                <img src=\"/files/API_Logo.jpg\" style=\"width: 70%; height: 50px;\"><br>\n                <b width=50% style=\"text-align: right; font-size: 20px;\">API Ispat and Powertech Private Limited</b>\n                {% endif %}\n                {% if doc.company == \"Real Ispat and Energy Private Limited\" %}\n                <img src=\"/files/RIEPL_FINAL.jpeg\" style=\"width: 60%; height: 70px;\"><br>\n                <b width=50% style=\"text-align: right; font-size: 20px;\">Real Ispat and Energy Private Limited</b>\n                {% endif %}\n                {% if doc.company == \"Shivalay Ispat and Power Private Limited\" %}\n                <img src=\"/files/shivalay.jpg\" style=\"width: 70%; height: 50px;\"><br>\n                <b width=50% style=\"text-align: right; font-size: 20px;\">Shivalay Ispat and Power Private Limited</b>\n                {% endif %}\n            </td>\n        </tr>\n    </tbody>\n</table>\n\n<br>\n<table style=\"border: 1px solid black; width: 100%;\">\n    <tbody style=\"border:1px solid black;\">\n        <tr >\n            <td colspan=\"2\">\n                <b>Mr. {{doc.employee_name}}</b>\n            </td>\n        </tr>\n        <tr style=\"border:1px solid black;\">\n            <td colspan=\"3\" style=\"border:1px solid black; background-color: #1f497d; color: #fff\">\n                <b style=\"color: #fff\">Employee Details</b>\n            </td>\n            <td colspan=\"3\" style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Payment & Leave Details</b>\n            </td>\n            <td colspan=\"3\" style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Location Details</b>\n            </td>\n        </tr>\n        <tr style=\"border:1px solid black; \">\n            <td colspan=\"2\" style=\"border: 1px solid black\"> <b>Employee #</b> </td>\n            <td style=\"border: 1px solid black\"> {{doc.employee}} </td>\n            <td style=\"border: 1px solid black\"> <b>Bank Name</b> </td>\n            <td colspan=\"2\" style=\"border: 1px solid black\"> {{doc.bank_name}} </td>\n            <td style=\"border: 1px solid black\"> <b>Location</b> </td>\n            <td style=\"border: 1px solid black\"> Raipur </td>\n        </tr>\n        <tr style=\"border:1px solid black;\">\n            <td colspan=\"2\" style=\"border: 1px solid black\"> <b>Designation</b> </td>\n            <td style=\"border: 1px solid black\"> {{doc.designation}} </td>\n            <td  style=\"border: 1px solid black\"> <b>Account #</b> </td>\n            <td colspan=\"2\" style=\"border: 1px solid black\"> {{doc.bank_account_no}} </td>\n            <td style=\"border: 1px solid black\"> <b>Division</b></td>\n            {% set br = frappe.db.get_value(\"Employee\", doc.employee, \"custom_division\") %}\n            {% if br %}\n            <td style=\"border: 1px solid black\"> {{br}} </td>\n            {% endif %}\n        </tr>\n        <tr style=\"border:1px solid black;\">\n            <td style=\"border:1px solid black;\">\n                <b>Grade</b>\n            </td>\n            {% set g = frappe.db.get_value(\"Employee\", doc.employee, \"grade\") %}\n            {% if g %}\n            <td style=\"border:1px solid black;\"> {{g}}</td>\n            {% endif %}\n            <td style=\"border:1px solid black;\">\n                <b>UAN</b>\n            </td>\n            {% set uan = frappe.db.get_value(\"Employee\", doc.employee, \"custom_uan\") %}\n            {% if uan %}\n            <td > {{uan}} </td>\n            {% else %}\n            <td></td>\n            {% endif %}\n            <td style=\"border: 1px solid black\"> <b>Days Paid</b> </td>\n            <td style=\"border: 1px solid black\"> {{doc.total_working_days}} </td>\n            <td style=\"border: 1px solid black\"> <b>Department</b> </td>\n            {% set department = frappe.db.get_value(\"Employee\", doc.employee, \"department\") %}\n            <td style=\"border: 1px solid black\"> {{doc.department}} </td>\n        </tr>\n        <tr style=\"border:1px solid black;\">\n            <td style=\"border: 1px solid black\"> <b>PAN </b></td>\n            {% set pn = frappe.db.get_value(\"Employee\", doc.employee, \"pan_number\") %}\n            {% if pn %}\n            <td style=\"border: 1px solid black\"> {{pn}} </td>\n            {% endif %}\n            <td style=\"border: 1px solid black\"><b>Leave Balance</b></td>\n            <td style=\"padding:0px !important;\">\n                <table height=60>\n                    <tr>\n                        <td style=\"vertical-align : middle !important; border-right: 1px solid black;\"><b>EL:</b></td>\n                        {% for leave in doc.leave_details %}\n                            {% if leave.leave_type == \"Earned Leave\" %}\n                            <td style=\"vertical-align : middle !important; border-right: 1px solid black\">\n                                  {{leave.available_leaves}}\n                            </td>\n                            {% endif %}\n                        {% endfor %}\n                  \n                        <td style=\"vertical-align : middle !important; border-right: 1px solid black\"><b>CL:</b></td>\n                        {% for leave in doc.leave_details %}\n                            {% if leave.leave_type == \"Casual Leave\" %}\n                            <td style=\"vertical-align : middle !important; \">\n                                  {{leave.available_leaves}}\n                            </td>\n                            {% endif %}\n                        {% endfor %}\n                        <td style=\"vertical-align : middle !important; border-right: 1px solid black; border-left: 1px solid black\"><b>C-Off:</b></td>\n                        {% for leave in doc.leave_details %}\n                            {% if leave.leave_type == \"Casual Leave\" %}\n                            <td style=\"vertical-align : middle !important; \">\n                                  {{leave.available_leaves}}\n                            </td>\n                            \n                            {% endif %}\n                        {% endfor %}\n                        \n                        <!--        <td>SL</td>-->\n                        <!--        {% for leave in doc.leave_details %}-->\n                        <!--    {% if leave.leave_type == \"Sick Leave\" %}-->\n                        <!--<td>-->\n                        <!--      {{leave.available_leaves}}-->\n                        <!--</td>-->\n                        <!--{% endif %}-->\n                        <!-- {% endfor %}-->\n                \n                    </tr>\n                </table>\n            </td>\n            <td style=\"border: 1px solid black\">\n                <b>ESIC</b>\n            </td>\n            {% set esic = frappe.db.get_value(\"Employee\", doc.employee, \"custom_esic\") %}\n            {% if esic %}\n            <td>\n                {{esic}}\n            </td>\n            {% endif %}\n        </tr>\n    </tbody>\n</table>\n<br>\n<table style=\"border: 1px solid black; width: 100%;\">\n    <tbody>\n        <tr width=100%>\n            <td width=25% style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Earnings</b>\n            </td>\n            <td width=15% style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Arrears (INR)</b>\n            </td>\n            <td width=15% style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Current (INR)</b>\n            </td>\n            <td width=25% style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Deduction</b>\n            </td>\n            <td width=20% style=\"border:1px solid black; background-color: #1f497d; color: white\">\n                <b style=\"color: #fff\">Amount (INR)</b>\n            </td>\n        </tr>\n        {% set greater_length_variable = doc.earnings|length if doc.earnings|length > doc.deductions|length else doc.deductions|length %}\n        {% for i in range(greater_length_variable) %}\n            {% if i < doc.earnings|length and doc.earnings[i].salary_component != \"Bonus\" %}\n            <tr width=100%>\n                <td width=20% style=\"border: 1px solid black;\">\n                        {{ doc.earnings[i].salary_component if i < doc.earnings|length else \"\" }}\n                </td>\n                <td width=20% style=\"border: 1px solid black;\" class=\"text-right\">\n                        {% if i < doc.earnings|length %}\n                        {% set earning = doc.earnings[i] %}\n                        {% if earning.component == 'Arrears' %}\n                        {{ frappe.format(earning.amount, {'fieldtype': 'Currency'}) }}\n                        {% endif %}\n                        {% endif %}\n                </td>\n                <td width=20% style=\"border: 1px solid black;\" class=\"text-right\">\n                    {{ frappe.format(doc.earnings[i].amount, {'fieldtype': 'Currency'}) if i < doc.earnings|length else \"\" }}\n                </td>\n                <td width=20% style=\"border: 1px solid black;\">\n                    {{ doc.deductions[i].salary_component if i < doc.deductions|length else \"\" }}\n                </td>\n                <td width=20% style=\"border: 1px solid black;\" class=\"text-right\">\n                    {{ frappe.format(doc.deductions[i].amount, {'fieldtype': 'Currency'}) if i < doc.deductions|length else \"\" }}\n                </td>\n            </tr>\n            {% endif %}\n        {% endfor %}\n        <tr>\n            <td style=\"border: 1px solid black;\">\n                <b>Total Earnings</b>\n            </td>\n            <td></td>\n            <td style=\"border: 1px solid black;\" class=\"text-right\">\n                <b>{{frappe.format(doc.gross_pay, {'fieldtype': 'Currency'})}}</b>\n            </td>\n            <td style=\"border: 1px solid black;\">\n                <b> Total Deductions</b>\n            </td>\n            <td style=\"border: 1px solid black;\" class=\"text-right\">\n                <b>{{frappe.format(doc.total_deduction, {'fieldtype': 'Currency'})}}</b>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<br>\n\n<table width=100%>\n    <tr>\n        <td style=\"padding:0px !important\">\n            <table style=\"border-collapse: collapse\">\n                <tbody>\n                    <tr>\n                        <td rowspan=\"2\" style=\"vertical-align : middle !important;text-align:center; border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; background-color: #1f497d; color: white\" class=\"text-center\"> <b style=\"color: #fff; font-size:20px\">Retirals </b><br> <b style=\"color: #fff; font-size:12px\">as On Month End</b></td>\n                        <td style=\"border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;  background-color: #1f497d; color: white\" class=\"text-center\"> <b style=\"color: #fff\">Provident Fund</b> </td>\n                        <td style=\"border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;  background-color: #1f497d; color: white\" class=\"text-center\"> <b style=\"color: #fff\">Gratuity</b> </td>\n                    </tr>\n                    <tr class=\"text-center\">\n                        <td style=\"border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;\" > 1000 </td>\n                        <td style=\"border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;\" > 1000 </td>\n                    </tr>\n                </tbody>\n            </table>\n        </td>\n        <td style=\"padding:0px !important\" align=\"right\">\n            <table>\n                <tr style=\"line-height:50px;\" class=\"text-center\" >\n                    <td style=\"border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;  background-color: #1f497d; color: white\" class=\"text-center\"> <b style=\"font-size:18px;color: #fff\">Net Pay (INR)</b> </td>\n                    <td style=\"border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; border-bottom: 1px solid black;\" class=\"text-center\"> <b style=\"color: solid black;\">{{ doc.net_pay }} </b> </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n</table>\n\n*inclusive of provisional interest\n",
